# Lume — environment configuration

# JWT signing secret. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Where the SQLite file lives. Override to use a different path.
DATABASE_PATH="./data/lume.db"

# Optional: enable Magic Draft via Anthropic. If unset, Lume falls back
# to a deterministic local template that still produces a useful draft.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
